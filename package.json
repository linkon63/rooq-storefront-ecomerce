    "@react-three/fiber": "^9.8.2",
    "@reduxjs/toolkit": "^2.14.0",
    "bcryptjs": "^3.0.3",
    "dayjs": "^1.11.21",
    "dotenv": "^17.4.2",
    "gsap": "^3.15.1",
    "jose": "^6.2.17",
