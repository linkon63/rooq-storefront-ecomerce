NEXT_PUBLIC_API_BASE_URL="http://localhost:5010/api/v1"
# Google OAuth (storefront social login) — Web application OAuth 2.0 Client ID
NEXT_PUBLIC_GOOGLE_CLIENT_ID=abc

# Google Tag Manager (storefront analytics) — leave unset to disable tracking
NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX

# Checkout — highlighted note under the delivery charge (leave unset to hide it)
NEXT_PUBLIC_FREE_DELIVERY_NOTE="৳২৫০০ টাকার বেশি অর্ডার করলে ডেলিভারি চার্জ লাগবে না — অর্ডার কনফার্ম করার সময় আমরা ডেলিভারি চার্জ ফ্রি করে দেব।"
