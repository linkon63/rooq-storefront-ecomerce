# --- Database (Supabase Postgres) ----------------------------------------------
# App queries: Supabase transaction pooler (port 6543).
# Rooq uses its own role + schema ("rooq") so it can share a Supabase project.
DATABASE_URL="postgresql://rooq.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?sslmode=require&pgbouncer=true&schema=rooq"
# Migrations / studio / db:copy: Supabase session pooler (port 5432).
DIRECT_URL="postgresql://rooq.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require&schema=rooq"
# Only for `pnpm db:copy`: the old database to copy every row (images included) from.
SOURCE_DATABASE_URL=""

# --- Auth -----------------------------------------------------------------
JWT_SECRET="replace-with-a-long-random-string"
JWT_EXPIRES_IN="7d"

# --- App URLs (the API is same-origin at /api/v1; no API URL is needed) ----
NEXT_PUBLIC_APP_URL="http://localhost:3002"
NEXT_PUBLIC_SITE_URL="http://localhost:3002"

# --- Seed -------------------------------------------------------------------
SEED_ADMIN_EMAIL="admin@rooq.local"
SEED_ADMIN_PASSWORD="ChangeMe123!"

# --- E-mail (Resend) — optional; without a key mail is a logged dry run ---
RESEND_API_KEY=""
RESEND_FROM_EMAIL="Rooq <onboarding@resend.dev>"
RESEND_TO_EMAIL=""
STORE_EMAIL=""

# --- Google OAuth (storefront social login) — optional --------------------
NEXT_PUBLIC_GOOGLE_CLIENT_ID=""

# --- Analytics — optional -------------------------------------------------
NEXT_PUBLIC_GTM_ID=""
