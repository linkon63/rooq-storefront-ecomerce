// Rooq — database schema for dbdiagram.io
// Source of truth: prisma/schema.prisma. Table and column names are the real Postgres names (@@map / @map).
// Paste this file into https://dbdiagram.io/d to view or edit it.

Project rooq {
  database_type: 'PostgreSQL'
  Note: '''
  Rooq fashion e-commerce (Next.js full-stack, Prisma 7, Postgres).
  * ids are UUID v7 strings generated by the Prisma client (time-ordered, B-tree friendly).
  * money is decimal(12,2); every FK column is indexed; every relation states its ON DELETE.
  * images are bytes in media_blobs (1:1 with media); every other table points at media by FK.
  * created_at defaults to now(); updated_at is set by Prisma on every update (@updatedAt).
  '''
}

// ---------------------------------------------------------------- enums
Enum "AuthProvider" {
  "local"
  "google"
}

Enum "MediaKind" {
  "IMAGE"
  "VIDEO"
}

Enum "MediaProvider" {
  "DATABASE"
  "EXTERNAL"
}

Enum "ProductStatus" {
  "active"
  "inactive"
  "draft"
}

Enum "Department" {
  "MEN"
  "WOMEN"
  "KIDS"
  "UNISEX"
}

Enum "Fit" {
  "SLIM"
  "REGULAR"
  "RELAXED"
  "OVERSIZED"
}

Enum "Season" {
  "SPRING_SUMMER"
  "AUTUMN_WINTER"
  "ALL_SEASON"
}

Enum "Occasion" {
  "CASUAL"
  "WORK"
  "FORMAL"
  "PARTY"
  "SPORT"
  "LOUNGE"
  "WEDDING"
  "TRAVEL"
}

Enum "Pattern" {
  "SOLID"
  "STRIPED"
  "CHECKED"
  "PRINTED"
  "FLORAL"
  "GRAPHIC"
  "TEXTURED"
  "COLOR_BLOCK"
}

Enum "SizeGroup" {
  "ALPHA"
  "NUMERIC"
  "SHOE"
  "ONE_SIZE"
}

Enum "CollectionType" {
  "COLLECTION"
  "LOOKBOOK"
}

Enum "StockMovementType" {
  "INITIAL"
  "RESTOCK"
  "SALE"
  "RETURN"
  "EXCHANGE"
  "CANCELLATION"
  "ADJUSTMENT"
  "CORRECTION"
}

Enum "BackInStockStatus" {
  "PENDING"
  "NOTIFIED"
  "CANCELLED"
}

Enum "FitFeedback" {
  "RUNS_SMALL"
  "TRUE_TO_SIZE"
  "RUNS_LARGE"
}

Enum "ReviewStatus" {
  "PENDING"
  "APPROVED"
  "REJECTED"
}

Enum "ReturnStatus" {
  "REQUESTED"
  "APPROVED"
  "REJECTED"
  "REFUNDED"
  "EXCHANGED"
  "CANCELLED"
}

Enum "ReturnResolution" {
  "REFUND"
  "EXCHANGE"
}

Enum "ReturnReason" {
  "TOO_SMALL"
  "TOO_LARGE"
  "NOT_AS_DESCRIBED"
  "DAMAGED"
  "WRONG_ITEM"
  "QUALITY"
  "CHANGED_MIND"
  "OTHER"
}

Enum "OrderStatus" {
  "pending"
  "processing"
  "shipped"
  "delivered"
  "cancelled"
  "returned"
}

Enum "PaymentStatus" {
  "unpaid"
  "paid"
  "partially_refunded"
  "refunded"
}

Enum "OrderType" {
  "retail"
  "wholesale"
}

Enum "DeliveryZone" {
  "inside"
  "near_city"
  "outside"
}

Enum "PaymentMethod" {
  "cash_on_delivery"
  "cash"
  "card"
  "bkash"
  "nagad"
  "rocket"
  "bank_transfer"
  "other"
}

Enum "PaymentTransactionStatus" {
  "pending"
  "success"
  "failed"
  "refunded"
}

Enum "ShipmentStatus" {
  "pending"
  "in_transit"
  "delivered"
  "failed"
  "returned"
}

Enum "WholesaleRequestStatus" {
  "pending"
  "info_requested"
  "approved"
  "rejected"
  "converted"
}

Enum "CouponType" {
  "percentage"
  "fixed"
}

Enum "DiscountType" {
  "percentage"
  "fixed"
}

Enum "ActiveStatus" {
  "active"
  "inactive"
}

Enum "ContactKind" {
  "PHONE"
  "EMAIL"
}

Enum "SocialPlatform" {
  "facebook"
  "instagram"
  "tiktok"
  "twitter"
  "linkedin"
  "youtube"
  "pinterest"
}

Enum "PolicyType" {
  "delivery"
  "return"
  "refund"
  "cancellation"
  "privacy"
  "terms"
}

Enum "NotificationType" {
  "ORDER"
  "RETURN"
  "STOCK"
  "REVIEW"
  "PROMO"
  "SYSTEM"
}

// ---------------------------------------------------------------- Identity & Access
Table "roles" [headercolor: #1565C0] {
  "id" text [pk, note: 'Default: uuid v7 (generated by Prisma client).']
  "name" text [unique, not null, note: 'Guards match on this name: "superadmin", "admin", "user".']
  "description" text
  "is_system" boolean [not null, default: false, note: 'Protected roles cannot be deleted from the admin panel.']
  "created_at" timestamp(3) [not null, default: `now()`]
  "updated_at" timestamp(3) [not null, note: 'Set by Prisma on every update (@updatedAt).']

  Note: 'Prisma model: Role.'
}

Table "permissions" [headercolor: #1565C0] {
  "id" text [pk, note: 'Default: uuid v7 (generated by Prisma client).']
  "name" text [unique, not null, note: 'Admin section key, e.g. "products", "orders" (see lib/constants/admin-sections).']
  "description" text
  "created_at" timestamp(3) [not null, default: `now()`]
  "updated_at" timestamp(3) [not null, note: 'Set by Prisma on every update (@updatedAt).']

  Note: 'Prisma model: Permission.'
}

Table "_role_permissions" [headercolor: #1565C0] {
  "A" text [not null, note: 'FK → permissions.id']
  "B" text [not null, note: 'FK → roles.id']

  indexes {
    ("A", "B") [pk]
    "B"
  }

  Note: 'Implicit many-to-many join table created by Prisma for Permission ↔ Role. "A" references permissions.id, "B" references roles.id.'
}

Table "users" [headercolor: #1565C0] {
  "id" text [pk, note: 'Default: uuid v7 (generated by Prisma client).']
  "name" text [not null]
  "email" text [unique]
  "password" text [note: 'bcrypt hash; null for Google-only accounts.']
  "phone" text [unique]
  "google_id" text [unique]
  "provider" AuthProvider [not null, default: 'local']
  "is_active" boolean [not null, default: true]
  "avatar_media_id" text [note: 'FK → media.id']
  "role_id" text [note: 'FK → roles.id']
  "email_verified_at" timestamp(3)
  "last_login_at" timestamp(3)
  "created_at" timestamp(3) [not null, default: `now()`]
  "updated_at" timestamp(3) [not null, note: 'Set by Prisma on every update (@updatedAt).']
  "deleted_at" timestamp(3)

  indexes {
    "role_id"
    "avatar_media_id"
    "created_at"
  }

  Note: 'Prisma model: User.'
}

Table "user_profiles" [headercolor: #1565C0] {
  "id" text [pk, note: 'Default: uuid v7 (generated by Prisma client).']
  "bio" text
  "date_of_birth" date
  "department" Department [note: 'Preferred department for personalised storefront defaults.']
  "user_id" text [unique, not null, note: 'FK → users.id']
  "created_at" timestamp(3) [not null, default: `now()`]
  "updated_at" timestamp(3) [not null, note: 'Set by Prisma on every update (@updatedAt).']

  Note: 'Prisma model: UserProfile.'
}

Table "user_sessions" [headercolor: #1565C0] {
  "id" text [pk, note: 'Default: uuid v7 (generated by Prisma client).']
  "token_hash" text [unique, not null, note: 'sha256 of the session token — the raw token is never stored.']
  "user_agent" text
  "ip_address" text
  "expires_at" timestamp(3) [not null]
  "revoked_at" timestamp(3)
  "user_id" text [not null, note: 'FK → users.id']
  "created_at" timestamp(3) [not null, default: `now()`]
  "updated_at" timestamp(3) [not null, note: 'Set by Prisma on every update (@updatedAt).']

  indexes {
    "user_id"
    "expires_at"
  }

  Note: 'Prisma model: UserSession.'
}

Table "password_resets" [headercolor: #1565C0] {
  "id" text [pk, note: 'Default: uuid v7 (generated by Prisma client).']
  "email" text [not null]
  "token_hash" text [unique, not null, note: 'sha256 of the emailed token — the raw token is never stored.']
  "expires_at" timestamp(3) [not null]
  "used_at" timestamp(3)
  "user_id" text [not null, note: 'FK → users.id']
  "created_at" timestamp(3) [not null, default: `now()`]
  "updated_at" timestamp(3) [not null, note: 'Set by Prisma on every update (@updatedAt).']

  indexes {
    "user_id"
    "expires_at"
  }

  Note: 'Prisma model: PasswordReset.'
}

Table "addresses" [headercolor: #1565C0] {
  "id" text [pk, note: 'Default: uuid v7 (generated by Prisma client).']
  "label" text
  "full_name" text [not null]
  "phone" text [not null]
  "address_line1" text [not null]
  "address_line2" text
  "city" text [not null]
  "state" text
  "postal_code" text
  "country" text [not null, default: 'Bangladesh']
  "is_default" boolean [not null, default: false]
  "user_id" text [not null, note: 'FK → users.id']
  "created_at" timestamp(3) [not null, default: `now()`]
  "updated_at" timestamp(3) [not null, note: 'Set by Prisma on every update (@updatedAt).']

  indexes {
    "user_id"
  }

  Note: 'Prisma model: Address.'
}

// ---------------------------------------------------------------- Media (binary images)
Table "media" [headercolor: #AD1457] {
  "id" text [pk, note: 'Default: uuid v7 (generated by Prisma client).']
  "kind" MediaKind [not null, default: 'IMAGE']
  "provider" MediaProvider [not null, default: 'DATABASE']
  "mime_type" text [not null]
  "alt" text
  "width" integer
  "height" integer
  "size_bytes" integer
  "checksum" text [note: 'sha256 hex of the stored bytes — dedupe key and HTTP ETag.']
  "external_url" text [note: 'Only for provider EXTERNAL (videos, OAuth avatars).']
  "uploaded_by_id" text [note: 'FK → users.id']
  "created_at" timestamp(3) [not null, default: `now()`]
  "updated_at" timestamp(3) [not null, note: 'Set by Prisma on every update (@updatedAt).']

  indexes {
    ("checksum", "provider") [unique, note: 'One row per image bytes; NULL checksums (EXTERNAL) stay distinct.']
    "uploaded_by_id"
    "created_at"
  }

  Note: 'Prisma model: Media.'
}

Table "media_blobs" [headercolor: #AD1457] {
  "media_id" text [pk, note: 'FK → media.id']
  "data" bytea [not null]
  "created_at" timestamp(3) [not null, default: `now()`]
  "updated_at" timestamp(3) [not null, note: 'Set by Prisma on every update (@updatedAt).']

  Note: 'Prisma model: MediaBlob.'
}

// ---------------------------------------------------------------- Catalog & Fashion
Table "products" [headercolor: #2E7D32] {
  "id" text [pk, note: 'Default: uuid v7 (generated by Prisma client).']
  "name" text [not null]
  "slug" text [unique, not null]
  "style_code" text [unique, note: 'Style code shared by every variant, e.g. "RQ-TS-001".']
  "short_description" text
  "description" text
  "status" ProductStatus [not null, default: 'draft']
  "is_featured" boolean [not null, default: false]
  "price" decimal(12,2) [not null, note: 'Base selling price; a variant may override it.']
  "compare_at_price" decimal(12,2) [note: 'Struck-through "was" price; on sale when compareAtPrice > price.']
  "cost_price" decimal(12,2) [note: 'Purchase cost from the supplier (reports / margin).']
  "department" Department [not null, default: 'UNISEX']
  "material" text
  "composition" text [note: '"95% Cotton, 5% Elastane"']
  "care_instructions" text
  "fit" Fit
  "season" Season
  "occasions" Occasion[] [not null]
  "pattern" Pattern
  "model_info" text [note: '"Model is 180 cm and wears size M"']
  "features" text[] [not null, note: 'Bullet list on the product page ("Organic cotton", "Relaxed shoulders").']
  "meta_title" text
  "meta_description" text
  "meta_keywords" text
  "sold_count" integer [not null, default: 0]
  "rating_avg" decimal(3,2) [not null, default: 0]
  "rating_count" integer [not null, default: 0]
  "brand_id" text [not null, note: 'FK → brands.id']
  "category_id" text [not null, note: 'FK → categories.id']
  "unit_id" text [note: 'FK → units.id']
  "supplier_id" text [note: 'FK → suppliers.id']
  "size_chart_id" text [note: 'Overrides the category\'s size chart. FK → size_charts.id']
  "published_at" timestamp(3)
  "created_at" timestamp(3) [not null, default: `now()`]
  "updated_at" timestamp(3) [not null, note: 'Set by Prisma on every update (@updatedAt).']
  "archived_at" timestamp(3) [note: 'Soft delete: archived products keep order history but leave the shop.']

  indexes {
    ("status", "archived_at")
    "category_id"
    "brand_id"
    "unit_id"
    "supplier_id"
    "size_chart_id"
    "department"
    "price"
    "created_at"
    "published_at"
    "sold_count"
    "is_featured"
  }

  Note: 'Prisma model: Product.'
}

Table "product_variants" [headercolor: #2E7D32] {
  "id" text [pk, note: 'Default: uuid v7 (generated by Prisma client).']
  "sku" text [unique, not null]
  "barcode" text [unique]
  "price" decimal(12,2) [note: 'Overrides Product.price / compareAtPrice / costPrice when set.']
  "compare_at_price" decimal(12,2)
  "cost_price" decimal(12,2)
  "stock" integer [not null, default: 0]
  "low_stock_threshold" integer [not null, default: 5]
  "weight_grams" integer
  "position" integer [not null, default: 0]
  "is_default" boolean [not null, default: false, note: 'The variant a listing card / product page opens on.']
  "is_active" boolean [not null, default: true, note: 'Archived variants stay for order history but are no longer sold.']
  "product_id" text [not null, note: 'FK → products.id']
  "color_id" text [not null, note: 'FK → colors.id']
  "size_id" text [not null, note: 'FK → sizes.id']
  "created_at" timestamp(3) [not null, default: `now()`]
  "updated_at" timestamp(3) [not null, note: 'Set by Prisma on every update (@updatedAt).']

  indexes {
    ("product_id", "color_id", "size_id") [unique]
    ("product_id", "is_active")
    "color_id"
    "size_id"
    "stock"
  }

  Note: 'Prisma model: ProductVariant. One sellable SKU = product × colour × size.'
}

Table "product_media" [headercolor: #2E7D32] {
  "id" text [pk, note: 'Default: uuid v7 (generated by Prisma client).']
  "position" integer [not null, default: 0]
  "is_primary" boolean [not null, default: false]
  "product_id" text [not null, note: 'FK → products.id']
  "media_id" text [not null, note: 'FK → media.id']
  "color_id" text [note: 'FK → colors.id']
  "created_at" timestamp(3) [not null, default: `now()`]
  "updated_at" timestamp(3) [not null, note: 'Set by Prisma on every update (@updatedAt).']

  indexes {
    ("product_id", "media_id") [unique]
    ("product_id", "color_id", "position")
    "media_id"
    "color_id"
  }

  Note: 'Prisma model: ProductMedia. Ordered product gallery. colorId set → the image belongs to that colour\'s gallery; null → shown for every colour.'
}

Table "product_attribute_values" [headercolor: #2E7D32] {
  "product_id" text [not null, note: 'FK → products.id']
  "attribute_value_id" text [not null, note: 'FK → attribute_values.id']
  "created_at" timestamp(3) [not null, default: `now()`]

  indexes {
    ("product_id", "attribute_value_id") [pk]
    "attribute_value_id"
  }

  Note: 'Prisma model: ProductAttributeValue.'
}

Table "categories" [headercolor: #2E7D32] {
  "id" text [pk, note: 'Default: uuid v7 (generated by Prisma client).']
  "name" text [not null]
  "slug" text [unique, not null]
  "description" text
  "sort_order" integer [not null, default: 0]
  "is_active" boolean [not null, default: true]
  "meta_title" text
  "meta_description" text
  "image_media_id" text [note: 'FK → media.id']
  "parent_id" text [note: 'FK → categories.id']
  "size_chart_id" text [note: 'Default size chart for products in this category (product may override). FK → size_charts.id']
  "created_at" timestamp(3) [not null, default: `now()`]
  "updated_at" timestamp(3) [not null, note: 'Set by Prisma on every update (@updatedAt).']

  indexes {
    ("parent_id", "sort_order")
    "image_media_id"
    "size_chart_id"
  }

  Note: 'Prisma model: Category.'
}

Table "brands" [headercolor: #2E7D32] {
  "id" text [pk, note: 'Default: uuid v7 (generated by Prisma client).']
  "name" text [unique, not null]
  "slug" text [unique, not null]
  "description" text
  "is_active" boolean [not null, default: true]
  "logo_media_id" text [note: 'FK → media.id']
  "created_at" timestamp(3) [not null, default: `now()`]
  "updated_at" timestamp(3) [not null, note: 'Set by Prisma on every update (@updatedAt).']

  indexes {
    "logo_media_id"
  }

  Note: 'Prisma model: Brand.'
}

Table "units" [headercolor: #2E7D32] {
  "id" text [pk, note: 'Default: uuid v7 (generated by Prisma client).']
  "name" text [not null]
  "code" text [unique, not null, note: 'Short form shown to staff and used to seed SKUs — "pcs", "pair", "set".']
  "description" text
  "is_active" boolean [not null, default: true]
  "parent_unit_id" text [note: 'Conversion tree: a base unit has no parent and factor 1; otherwise 1 of this unit = factor × parent (e.g. Dozen → Piece, factor 12). FK → units.id']
  "factor" decimal(18,6) [not null, default: 1]
  "created_at" timestamp(3) [not null, default: `now()`]
  "updated_at" timestamp(3) [not null, note: 'Set by Prisma on every update (@updatedAt).']

  indexes {
    "parent_unit_id"
  }

  Note: 'Prisma model: Unit.'
}

Table "suppliers" [headercolor: #2E7D32] {
  "id" text [pk, note: 'Default: uuid v7 (generated by Prisma client).']
  "name" text [not null]
  "phone" text
  "email" text
  "address" text
  "is_active" boolean [not null, default: true]
  "created_at" timestamp(3) [not null, default: `now()`]
  "updated_at" timestamp(3) [not null, note: 'Set by Prisma on every update (@updatedAt).']

  indexes {
    "name"
  }

  Note: 'Prisma model: Supplier.'
}

Table "tags" [headercolor: #2E7D32] {
  "id" text [pk, note: 'Default: uuid v7 (generated by Prisma client).']
  "name" text [not null]
  "slug" text [unique, not null]
  "description" text
  "is_active" boolean [not null, default: true]
  "created_at" timestamp(3) [not null, default: `now()`]
  "updated_at" timestamp(3) [not null, note: 'Set by Prisma on every update (@updatedAt).']

  Note: 'Prisma model: Tag.'
}

Table "_product_tags" [headercolor: #2E7D32] {
  "A" text [not null, note: 'FK → products.id']
  "B" text [not null, note: 'FK → tags.id']

  indexes {
    ("A", "B") [pk]
    "B"
  }

  Note: 'Implicit many-to-many join table created by Prisma for Product ↔ Tag. "A" references products.id, "B" references tags.id.'
}

Table "attributes" [headercolor: #2E7D32] {
  "id" text [pk, note: 'Default: uuid v7 (generated by Prisma client).']
  "name" text [unique, not null]
  "slug" text [unique, not null]
  "sort_order" integer [not null, default: 0]
  "created_at" timestamp(3) [not null, default: `now()`]
  "updated_at" timestamp(3) [not null, note: 'Set by Prisma on every update (@updatedAt).']

  Note: 'Prisma model: Attribute. Descriptive product facets that are NOT variant axes — e.g. "Neckline", "Sleeve length", "Closure". Size and colour have their own masters.'
}

Table "attribute_values" [headercolor: #2E7D32] {
  "id" text [pk, note: 'Default: uuid v7 (generated by Prisma client).']
  "value" text [not null]
  "sort_order" integer [not null, default: 0]
  "attribute_id" text [not null, note: 'FK → attributes.id']
  "created_at" timestamp(3) [not null, default: `now()`]
  "updated_at" timestamp(3) [not null, note: 'Set by Prisma on every update (@updatedAt).']

  indexes {
    ("attribute_id", "value") [unique]
  }

  Note: 'Prisma model: AttributeValue.'
}

Table "colors" [headercolor: #2E7D32] {
  "id" text [pk, note: 'Default: uuid v7 (generated by Prisma client).']
  "name" text [unique, not null]
  "slug" text [unique, not null]
  "hex" text [not null, note: '"#RRGGBB"']
  "family" text [note: 'Coarse family for the shop filter ("Blue" groups Navy, Sky, Indigo).']
  "sort_order" integer [not null, default: 0]
  "is_active" boolean [not null, default: true]
  "created_at" timestamp(3) [not null, default: `now()`]
  "updated_at" timestamp(3) [not null, note: 'Set by Prisma on every update (@updatedAt).']

  indexes {
    "family"
    "sort_order"
  }

  Note: 'Prisma model: Color.'
}

Table "sizes" [headercolor: #2E7D32] {
  "id" text [pk, note: 'Default: uuid v7 (generated by Prisma client).']
  "label" text [not null]
  "slug" text [unique, not null]
  "size_group" SizeGroup [not null]
  "sort_order" integer [not null, default: 0]
  "is_active" boolean [not null, default: true]
  "created_at" timestamp(3) [not null, default: `now()`]
  "updated_at" timestamp(3) [not null, note: 'Set by Prisma on every update (@updatedAt).']

  indexes {
    ("size_group", "label") [unique]
    ("size_group", "sort_order")
  }

  Note: 'Prisma model: Size.'
}

Table "size_charts" [headercolor: #2E7D32] {
  "id" text [pk, note: 'Default: uuid v7 (generated by Prisma client).']
  "name" text [unique, not null]
  "slug" text [unique, not null]
  "description" text
  "how_to_measure" text [note: 'Free-text "how to measure" guidance shown in the size guide modal.']
  "department" Department
  "is_active" boolean [not null, default: true]
  "created_at" timestamp(3) [not null, default: `now()`]
  "updated_at" timestamp(3) [not null, note: 'Set by Prisma on every update (@updatedAt).']

  Note: 'Prisma model: SizeChart.'
}

Table "size_chart_rows" [headercolor: #2E7D32] {
  "id" text [pk, note: 'Default: uuid v7 (generated by Prisma client).']
  "position" integer [not null, default: 0]
  "size_chart_id" text [not null, note: 'FK → size_charts.id']
  "size_id" text [not null, note: 'FK → sizes.id']
  "created_at" timestamp(3) [not null, default: `now()`]
  "updated_at" timestamp(3) [not null, note: 'Set by Prisma on every update (@updatedAt).']

  indexes {
    ("size_chart_id", "size_id") [unique]
    "size_id"
  }

  Note: 'Prisma model: SizeChartRow.'
}

Table "size_chart_measurements" [headercolor: #2E7D32] {
  "id" text [pk, note: 'Default: uuid v7 (generated by Prisma client).']
  "label" text [not null, note: 'Column header — "Chest", "Waist", "Length", "Foot length".']
  "value_cm" decimal(6,1) [not null]
  "position" integer [not null, default: 0]
  "row_id" text [not null, note: 'FK → size_chart_rows.id']
  "created_at" timestamp(3) [not null, default: `now()`]
  "updated_at" timestamp(3) [not null, note: 'Set by Prisma on every update (@updatedAt).']

  indexes {
    ("row_id", "label") [unique]
  }

  Note: 'Prisma model: SizeChartMeasurement. One cell of the size chart. Stored in centimetres; inches are derived.'
}

Table "collections" [headercolor: #2E7D32] {
  "id" text [pk, note: 'Default: uuid v7 (generated by Prisma client).']
  "name" text [not null]
  "slug" text [unique, not null]
  "description" text
  "type" CollectionType [not null, default: 'COLLECTION']
  "is_active" boolean [not null, default: true]
  "is_featured" boolean [not null, default: false]
  "position" integer [not null, default: 0]
  "starts_at" timestamp(3)
  "ends_at" timestamp(3)
  "meta_title" text
  "meta_description" text
  "cover_media_id" text [note: 'FK → media.id']
  "created_at" timestamp(3) [not null, default: `now()`]
  "updated_at" timestamp(3) [not null, note: 'Set by Prisma on every update (@updatedAt).']

  indexes {
    ("type", "is_active", "position")
    "cover_media_id"
  }

  Note: 'Prisma model: Collection.'
}

Table "collection_products" [headercolor: #2E7D32] {
  "position" integer [not null, default: 0]
  "collection_id" text [not null, note: 'FK → collections.id']
  "product_id" text [not null, note: 'FK → products.id']
  "created_at" timestamp(3) [not null, default: `now()`]

  indexes {
    ("collection_id", "product_id") [pk]
    "product_id"
  }

  Note: 'Prisma model: CollectionProduct.'
}

Table "collection_looks" [headercolor: #2E7D32] {
  "id" text [pk, note: 'Default: uuid v7 (generated by Prisma client).']
  "title" text
  "description" text
  "position" integer [not null, default: 0]
  "collection_id" text [not null, note: 'FK → collections.id']
  "media_id" text [note: 'FK → media.id']
  "created_at" timestamp(3) [not null, default: `now()`]
  "updated_at" timestamp(3) [not null, note: 'Set by Prisma on every update (@updatedAt).']

  indexes {
    ("collection_id", "position")
    "media_id"
  }

  Note: 'Prisma model: CollectionLook. A "shop the look" scene inside a lookbook: one image + the products worn.'
}

Table "collection_look_items" [headercolor: #2E7D32] {
  "position" integer [not null, default: 0]
  "look_id" text [not null, note: 'FK → collection_looks.id']
  "product_id" text [not null, note: 'FK → products.id']
  "created_at" timestamp(3) [not null, default: `now()`]

  indexes {
    ("look_id", "product_id") [pk]
    "product_id"
  }

  Note: 'Prisma model: CollectionLookItem.'
}

// ---------------------------------------------------------------- Inventory
Table "stock_movements" [headercolor: #F9A825] {
  "id" text [pk, note: 'Default: uuid v7 (generated by Prisma client).']
  "type" StockMovementType [not null]
  "quantity" integer [not null, note: 'Signed delta: +10 restock, -1 sale.']
  "stock_after" integer [not null, note: 'Variant stock right after this movement.']
  "reason" text
  "variant_id" text [not null, note: 'FK → product_variants.id']
  "order_id" text [note: 'FK → orders.id']
  "return_request_id" text [note: 'FK → return_requests.id']
  "created_by_id" text [note: 'FK → users.id']
  "created_at" timestamp(3) [not null, default: `now()`]

  indexes {
    ("variant_id", "created_at")
    "order_id"
    "return_request_id"
    "created_by_id"
    ("type", "created_at")
  }

  Note: 'Prisma model: StockMovement. Append-only ledger. ProductVariant.stock is the running balance; each change writes one row here inside the same transaction.'
}

Table "back_in_stock_requests" [headercolor: #F9A825] {
  "id" text [pk, note: 'Default: uuid v7 (generated by Prisma client).']
  "email" text [not null]
  "status" BackInStockStatus [not null, default: 'PENDING']
  "notified_at" timestamp(3)
  "variant_id" text [not null, note: 'FK → product_variants.id']
  "user_id" text [note: 'FK → users.id']
  "created_at" timestamp(3) [not null, default: `now()`]
  "updated_at" timestamp(3) [not null, note: 'Set by Prisma on every update (@updatedAt).']

  indexes {
    ("variant_id", "email") [unique]
    ("status", "variant_id")
    "user_id"
    "created_at"
  }

  Note: 'Prisma model: BackInStockRequest.'
}

// ---------------------------------------------------------------- Commerce (cart, orders, payments, pricing, wholesale)
Table "carts" [headercolor: #4527A0] {
  "id" text [pk, note: 'Default: uuid v7 (generated by Prisma client).']
  "user_id" text [unique, note: 'Signed-in cart (one per user) … FK → users.id']
  "session_token" text [unique, note: '… or a guest cart keyed by an opaque cookie token.']
  "created_at" timestamp(3) [not null, default: `now()`]
  "updated_at" timestamp(3) [not null, note: 'Set by Prisma on every update (@updatedAt).']

  Note: 'Prisma model: Cart.'
}

Table "cart_items" [headercolor: #4527A0] {
  "id" text [pk, note: 'Default: uuid v7 (generated by Prisma client).']
  "quantity" integer [not null]
  "cart_id" text [not null, note: 'FK → carts.id']
  "variant_id" text [not null, note: 'FK → product_variants.id']
  "created_at" timestamp(3) [not null, default: `now()`]
  "updated_at" timestamp(3) [not null, note: 'Set by Prisma on every update (@updatedAt).']

  indexes {
    ("cart_id", "variant_id") [unique]
    "variant_id"
  }

  Note: 'Prisma model: CartItem.'
}

Table "wishlists" [headercolor: #4527A0] {
  "id" text [pk, note: 'Default: uuid v7 (generated by Prisma client).']
  "user_id" text [not null, note: 'FK → users.id']
  "product_id" text [not null, note: 'FK → products.id']
  "created_at" timestamp(3) [not null, default: `now()`]
  "updated_at" timestamp(3) [not null, note: 'Set by Prisma on every update (@updatedAt).']

  indexes {
    ("user_id", "product_id") [unique]
    "product_id"
  }

  Note: 'Prisma model: Wishlist.'
}

Table "orders" [headercolor: #4527A0] {
  "id" text [pk, note: 'Default: uuid v7 (generated by Prisma client).']
  "order_number" text [unique, not null]
  "invoice_number" text [unique, note: '"INV-2026-000123", issued once at creation and never changed.']
  "status" OrderStatus [not null, default: 'pending']
  "payment_status" PaymentStatus [not null, default: 'unpaid']
  "order_type" OrderType [not null, default: 'retail']
  "delivery_zone" DeliveryZone
  "currency" text [not null, default: 'BDT']
  "subtotal" decimal(12,2) [not null, default: 0, note: 'Σ listPrice × qty, before any offer.']
  "product_discount" decimal(12,2) [not null, default: 0, note: 'What product offers took off, frozen at placement.']
  "discount" decimal(12,2) [not null, default: 0, note: 'Coupon discount only.']
  "shipping_cost" decimal(12,2) [not null, default: 0]
  "tax" decimal(12,2) [not null, default: 0]
  "total" decimal(12,2) [not null]
  "coupon_code" text
  "coupon_id" text [note: 'FK → coupons.id']
  "customer_note" text
  "admin_note" text
  "user_id" text [note: 'Null for guest orders. FK → users.id']
  "address_id" text [note: 'Saved address it was shipped to (if any); the frozen copy is shippingAddress. FK → addresses.id']
  "placed_at" timestamp(3) [not null, default: `now()`]
  "updated_at" timestamp(3) [not null, note: 'Set by Prisma on every update (@updatedAt).']

  indexes {
    ("user_id", "placed_at")
    ("status", "placed_at")
    "payment_status"
    "placed_at"
    "address_id"
    "coupon_id"
  }

  Note: 'Prisma model: Order.'
}

Table "order_addresses" [headercolor: #4527A0] {
  "order_id" text [pk, note: 'FK → orders.id']
  "email" text
  "full_name" text [not null]
  "phone" text [not null]
  "address_line1" text [not null]
  "address_line2" text
  "city" text [not null]
  "state" text
  "postal_code" text
  "country" text [not null, default: 'Bangladesh']
  "created_at" timestamp(3) [not null, default: `now()`]
  "updated_at" timestamp(3) [not null, note: 'Set by Prisma on every update (@updatedAt).']

  indexes {
    "phone"
    "email"
  }

  Note: 'Prisma model: OrderAddress. Frozen shipping address/contact for an order (guest or signed-in).'
}

Table "order_items" [headercolor: #4527A0] {
  "id" text [pk, note: 'Default: uuid v7 (generated by Prisma client).']
  "product_name" text [not null]
  "product_slug" text
  "sku" text [not null]
  "color_name" text
  "color_hex" text
  "size_label" text
  "quantity" integer [not null]
  "unit_price" decimal(12,2) [not null, note: 'Charged per unit — the offer price when one applied.']
  "list_price" decimal(12,2) [not null, note: 'Catalogue price per unit before any offer.']
  "discount_amount" decimal(12,2) [not null, default: 0, note: '(listPrice − unitPrice) × quantity.']
  "total_price" decimal(12,2) [not null, note: 'unitPrice × quantity.']
  "order_id" text [not null, note: 'FK → orders.id']
  "product_id" text [note: 'FK → products.id']
  "variant_id" text [note: 'FK → product_variants.id']
  "image_media_id" text [note: 'FK → media.id']
  "created_at" timestamp(3) [not null, default: `now()`]
  "updated_at" timestamp(3) [not null, note: 'Set by Prisma on every update (@updatedAt).']

  indexes {
    "order_id"
    "product_id"
    "variant_id"
    "image_media_id"
  }

  Note: 'Prisma model: OrderItem. Line snapshot: survives later edits/archiving of product & variant.'
}

Table "order_status_logs" [headercolor: #4527A0] {
  "id" text [pk, note: 'Default: uuid v7 (generated by Prisma client).']
  "status" OrderStatus [not null]
  "note" text
  "order_id" text [not null, note: 'FK → orders.id']
  "changed_by_id" text [note: 'FK → users.id']
  "created_at" timestamp(3) [not null, default: `now()`]

  indexes {
    ("order_id", "created_at")
    "changed_by_id"
  }

  Note: 'Prisma model: OrderStatusLog.'
}

Table "invoice_counters" [headercolor: #4527A0] {
  "year" integer [pk]
  "last_number" integer [not null, default: 0]
  "created_at" timestamp(3) [not null, default: `now()`]
  "updated_at" timestamp(3) [not null, note: 'Set by Prisma on every update (@updatedAt).']

  Note: 'Prisma model: InvoiceCounter. Last invoice number issued per year (numbering restarts every January).'
}

Table "payments" [headercolor: #4527A0] {
  "id" text [pk, note: 'Default: uuid v7 (generated by Prisma client).']
  "amount" decimal(12,2) [not null]
  "method" PaymentMethod [not null]
  "transaction_id" text
  "status" PaymentTransactionStatus [not null, default: 'pending']
  "paid_at" timestamp(3)
  "order_id" text [not null, note: 'FK → orders.id']
  "created_at" timestamp(3) [not null, default: `now()`]
  "updated_at" timestamp(3) [not null, note: 'Set by Prisma on every update (@updatedAt).']

  indexes {
    "order_id"
    "transaction_id"
    "status"
  }

  Note: 'Prisma model: Payment.'
}

Table "shipments" [headercolor: #4527A0] {
  "id" text [pk, note: 'Default: uuid v7 (generated by Prisma client).']
  "courier_name" text [not null]
  "tracking_number" text
  "status" ShipmentStatus [not null, default: 'pending']
  "shipped_at" timestamp(3)
  "delivered_at" timestamp(3)
  "order_id" text [not null, note: 'FK → orders.id']
  "created_at" timestamp(3) [not null, default: `now()`]
  "updated_at" timestamp(3) [not null, note: 'Set by Prisma on every update (@updatedAt).']

  indexes {
    "order_id"
    "tracking_number"
  }

  Note: 'Prisma model: Shipment.'
}

Table "coupons" [headercolor: #4527A0] {
  "id" text [pk, note: 'Default: uuid v7 (generated by Prisma client).']
  "code" text [unique, not null]
  "type" CouponType [not null]
  "value" decimal(12,2) [not null]
  "max_usage" integer [note: 'Null = unlimited.']
  "used_count" integer [not null, default: 0]
  "min_order_amount" decimal(12,2)
  "is_active" boolean [not null, default: true]
  "starts_at" timestamp(3)
  "expires_at" timestamp(3)
  "created_at" timestamp(3) [not null, default: `now()`]
  "updated_at" timestamp(3) [not null, note: 'Set by Prisma on every update (@updatedAt).']

  indexes {
    ("is_active", "expires_at")
  }

  Note: 'Prisma model: Coupon.'
}

Table "product_discounts" [headercolor: #4527A0] {
  "id" text [pk, note: 'Default: uuid v7 (generated by Prisma client).']
  "name" text [not null]
  "type" DiscountType [not null]
  "value" decimal(12,2) [not null]
  "start_date" timestamp(3)
  "end_date" timestamp(3)
  "status" ActiveStatus [not null, default: 'active']
  "created_at" timestamp(3) [not null, default: `now()`]
  "updated_at" timestamp(3) [not null, note: 'Set by Prisma on every update (@updatedAt).']

  indexes {
    ("status", "start_date", "end_date")
  }

  Note: 'Prisma model: ProductDiscount.'
}

Table "discount_products" [headercolor: #4527A0] {
  "discount_id" text [not null, note: 'FK → product_discounts.id']
  "product_id" text [not null, note: 'FK → products.id']
  "created_at" timestamp(3) [not null, default: `now()`]

  indexes {
    ("discount_id", "product_id") [pk]
    "product_id"
  }

  Note: 'Prisma model: DiscountProduct.'
}

Table "wholesale_order_requests" [headercolor: #4527A0] {
  "id" text [pk, note: 'Default: uuid v7 (generated by Prisma client).']
  "request_number" text [unique, not null]
  "status" WholesaleRequestStatus [not null, default: 'pending']
  "customer_note" text
  "admin_note" text
  "info_request_message" text
  "contact_phone" text
  "user_id" text [not null, note: 'FK → users.id']
  "order_id" text [unique, note: 'FK → orders.id']
  "reviewed_at" timestamp(3)
  "created_at" timestamp(3) [not null, default: `now()`]
  "updated_at" timestamp(3) [not null, note: 'Set by Prisma on every update (@updatedAt).']

  indexes {
    "user_id"
    ("status", "created_at")
  }

  Note: 'Prisma model: WholesaleOrderRequest.'
}

Table "wholesale_order_request_items" [headercolor: #4527A0] {
  "id" text [pk, note: 'Default: uuid v7 (generated by Prisma client).']
  "requested_quantity" integer [not null]
  "target_price" decimal(12,2)
  "note" text
  "request_id" text [not null, note: 'FK → wholesale_order_requests.id']
  "product_id" text [not null, note: 'FK → products.id']
  "variant_id" text [note: 'FK → product_variants.id']
  "created_at" timestamp(3) [not null, default: `now()`]
  "updated_at" timestamp(3) [not null, note: 'Set by Prisma on every update (@updatedAt).']

  indexes {
    "request_id"
    "product_id"
    "variant_id"
  }

  Note: 'Prisma model: WholesaleOrderRequestItem.'
}

// ---------------------------------------------------------------- Returns & Exchanges
Table "return_requests" [headercolor: #C62828] {
  "id" text [pk, note: 'Default: uuid v7 (generated by Prisma client).']
  "request_number" text [unique, not null, note: '"RET-2026-000042"']
  "status" ReturnStatus [not null, default: 'REQUESTED']
  "resolution" ReturnResolution [not null]
  "customer_note" text
  "admin_note" text
  "refund_amount" decimal(12,2)
  "order_id" text [not null, note: 'FK → orders.id']
  "user_id" text [note: 'Null when the order was a guest order. FK → users.id']
  "approved_at" timestamp(3)
  "resolved_at" timestamp(3)
  "created_at" timestamp(3) [not null, default: `now()`]
  "updated_at" timestamp(3) [not null, note: 'Set by Prisma on every update (@updatedAt).']

  indexes {
    ("status", "created_at")
    "order_id"
    "user_id"
  }

  Note: 'Prisma model: ReturnRequest.'
}

Table "return_items" [headercolor: #C62828] {
  "id" text [pk, note: 'Default: uuid v7 (generated by Prisma client).']
  "quantity" integer [not null]
  "reason" ReturnReason [not null]
  "note" text
  "restocked" boolean [not null, default: false, note: 'Set once the returned units have been put back into stock.']
  "return_request_id" text [not null, note: 'FK → return_requests.id']
  "order_item_id" text [not null, note: 'FK → order_items.id']
  "exchange_variant_id" text [note: 'For EXCHANGE: the size/colour the customer wants instead. FK → product_variants.id']
  "created_at" timestamp(3) [not null, default: `now()`]
  "updated_at" timestamp(3) [not null, note: 'Set by Prisma on every update (@updatedAt).']

  indexes {
    ("return_request_id", "order_item_id") [unique]
    "order_item_id"
    "exchange_variant_id"
  }

  Note: 'Prisma model: ReturnItem.'
}

// ---------------------------------------------------------------- Content & Marketing
Table "reviews" [headercolor: #00838F] {
  "id" text [pk, note: 'Default: uuid v7 (generated by Prisma client).']
  "rating" integer [not null, note: '1–5, validated by the API.']
  "title" text
  "comment" text
  "fit_feedback" FitFeedback
  "status" ReviewStatus [not null, default: 'APPROVED']
  "is_verified_purchase" boolean [not null, default: false]
  "product_id" text [not null, note: 'FK → products.id']
  "user_id" text [not null, note: 'FK → users.id']
  "variant_id" text [note: 'The size/colour the reviewer bought — powers "wears M" on the review. FK → product_variants.id']
  "created_at" timestamp(3) [not null, default: `now()`]
  "updated_at" timestamp(3) [not null, note: 'Set by Prisma on every update (@updatedAt).']

  indexes {
    ("product_id", "user_id") [unique]
    ("product_id", "status", "created_at")
    "user_id"
    "variant_id"
  }

  Note: 'Prisma model: Review.'
}

Table "review_media" [headercolor: #00838F] {
  "position" integer [not null, default: 0]
  "review_id" text [not null, note: 'FK → reviews.id']
  "media_id" text [not null, note: 'FK → media.id']
  "created_at" timestamp(3) [not null, default: `now()`]

  indexes {
    ("review_id", "media_id") [pk]
    "media_id"
  }

  Note: 'Prisma model: ReviewMedia.'
}

Table "sections" [headercolor: #00838F] {
  "id" text [pk, note: 'Default: uuid v7 (generated by Prisma client).']
  "title" text [not null]
  "page" text [not null, note: 'Page key the section renders on ("home", "shop").']
  "position" integer [not null]
  "created_at" timestamp(3) [not null, default: `now()`]
  "updated_at" timestamp(3) [not null, note: 'Set by Prisma on every update (@updatedAt).']

  indexes {
    ("page", "title") [unique]
    ("page", "position")
  }

  Note: 'Prisma model: Section.'
}

Table "campaigns" [headercolor: #00838F] {
  "id" text [pk, note: 'Default: uuid v7 (generated by Prisma client).']
  "title" text [not null]
  "description" text
  "link_url" text [note: 'Optional call-to-action link ("/shop?collection=summer-edit").']
  "link_label" text
  "has_discount" boolean [not null, default: false]
  "status" ActiveStatus [not null, default: 'active']
  "start_at" timestamp(3) [not null, default: `now()`]
  "end_at" timestamp(3)
  "section_id" text [not null, note: 'FK → sections.id']
  "discount_id" text [note: 'FK → product_discounts.id']
  "created_at" timestamp(3) [not null, default: `now()`]
  "updated_at" timestamp(3) [not null, note: 'Set by Prisma on every update (@updatedAt).']

  indexes {
    "section_id"
    "discount_id"
    ("status", "start_at", "end_at")
  }

  Note: 'Prisma model: Campaign.'
}

Table "campaign_media" [headercolor: #00838F] {
  "position" integer [not null, default: 0]
  "campaign_id" text [not null, note: 'FK → campaigns.id']
  "media_id" text [not null, note: 'FK → media.id']
  "created_at" timestamp(3) [not null, default: `now()`]

  indexes {
    ("campaign_id", "media_id") [pk]
    "media_id"
  }

  Note: 'Prisma model: CampaignMedia.'
}

Table "news" [headercolor: #00838F] {
  "id" text [pk, note: 'Default: uuid v7 (generated by Prisma client).']
  "title" text [not null]
  "slug" text [unique, not null]
  "excerpt" text
  "content" text [not null]
  "author" text
  "is_published" boolean [not null, default: false]
  "published_at" timestamp(3)
  "cover_media_id" text [note: 'FK → media.id']
  "created_at" timestamp(3) [not null, default: `now()`]
  "updated_at" timestamp(3) [not null, note: 'Set by Prisma on every update (@updatedAt).']

  indexes {
    ("is_published", "published_at")
    "cover_media_id"
  }

  Note: 'Prisma model: News.'
}

Table "policies" [headercolor: #00838F] {
  "id" text [pk, note: 'Default: uuid v7 (generated by Prisma client).']
  "type" PolicyType [unique, not null]
  "title" text [not null]
  "content" text [not null]
  "created_at" timestamp(3) [not null, default: `now()`]
  "updated_at" timestamp(3) [not null, note: 'Set by Prisma on every update (@updatedAt).']

  Note: 'Prisma model: Policy.'
}

Table "newsletter_subscribers" [headercolor: #00838F] {
  "id" text [pk, note: 'Default: uuid v7 (generated by Prisma client).']
  "email" text [unique, not null, note: 'Stored lower-cased; one row per address.']
  "source" text [note: 'Where the sign-up came from (e.g. "footer").']
  "unsubscribed_at" timestamp(3) [note: 'Set on opt-out; the row is kept so re-subscribing is idempotent.']
  "created_at" timestamp(3) [not null, default: `now()`]
  "updated_at" timestamp(3) [not null, note: 'Set by Prisma on every update (@updatedAt).']

  indexes {
    "created_at"
  }

  Note: 'Prisma model: NewsletterSubscriber. Standalone (no foreign keys).'
}

// ---------------------------------------------------------------- Platform (settings, notifications, audit)
Table "settings" [headercolor: #455A64] {
  "id" text [pk, note: 'Default: uuid v7 (generated by Prisma client).']
  "shop_name" text [not null, default: 'Rooq']
  "slogan" text
  "footer_description" text
  "branch_name" text
  "branch_address" text
  "branch_lat" float8
  "branch_lng" float8
  "copyright_year" text
  "parent_company" text
  "parent_company_link" text
  "opening_time" text [note: '24-hour "HH:mm"']
  "closing_time" text
  "currency" text [not null, default: 'BDT']
  "language" text [not null, default: 'en']
  "show_certifications" boolean [not null, default: false]
  "is_top_bar_visible" boolean [not null, default: true]
  "hide_out_of_stock" boolean [not null, default: false]
  "delivery_charge_inside" decimal(12,2) [not null, default: 0]
  "delivery_charge_near_city" decimal(12,2) [not null, default: 0]
  "delivery_charge_outside" decimal(12,2) [not null, default: 0]
  "free_shipping_threshold" decimal(12,2)
  "return_window_days" integer [not null, default: 14, note: 'Days after delivery a customer may open a return.']
  "low_stock_threshold" integer [not null, default: 5, note: 'Default low-stock threshold for new variants and dashboard alerts.']
  "fraud_check_api_key" text
  "is_fraud_checking" boolean [not null, default: false]
  "fraud_checking_threshold" integer [not null, default: 0]
  "fraud_checking_success_rate" decimal(5,2)
  "youtube_url" text
  "youtube_title" text
  "youtube_description" text
  "youtube_meta_data" jsonb
  "logo_media_id" text [note: 'FK → media.id']
  "icon_media_id" text [note: 'FK → media.id']
  "favicon_media_id" text [note: 'FK → media.id']
  "youtube_thumb_media_id" text [note: 'FK → media.id']
  "created_at" timestamp(3) [not null, default: `now()`]
  "updated_at" timestamp(3) [not null, note: 'Set by Prisma on every update (@updatedAt).']

  indexes {
    "logo_media_id"
    "icon_media_id"
    "favicon_media_id"
    "youtube_thumb_media_id"
  }

  Note: 'Prisma model: Setting. Singleton row (the service always reads the first one).'
}

Table "store_contacts" [headercolor: #455A64] {
  "id" text [pk, note: 'Default: uuid v7 (generated by Prisma client).']
  "kind" ContactKind [not null]
  "title" text [not null]
  "value" text [not null]
  "position" integer [not null, default: 0]
  "setting_id" text [not null, note: 'FK → settings.id']
  "created_at" timestamp(3) [not null, default: `now()`]
  "updated_at" timestamp(3) [not null, note: 'Set by Prisma on every update (@updatedAt).']

  indexes {
    ("setting_id", "kind", "position")
  }

  Note: 'Prisma model: StoreContact. Phone numbers and e-mail addresses shown on the storefront.'
}

Table "store_social_links" [headercolor: #455A64] {
  "id" text [pk, note: 'Default: uuid v7 (generated by Prisma client).']
  "platform" SocialPlatform [not null]
  "url" text [not null]
  "setting_id" text [not null, note: 'FK → settings.id']
  "created_at" timestamp(3) [not null, default: `now()`]
  "updated_at" timestamp(3) [not null, note: 'Set by Prisma on every update (@updatedAt).']

  indexes {
    ("setting_id", "platform") [unique]
  }

  Note: 'Prisma model: StoreSocialLink.'
}

Table "notifications" [headercolor: #455A64] {
  "id" text [pk, note: 'Default: uuid v7 (generated by Prisma client).']
  "type" NotificationType [not null, default: 'SYSTEM']
  "title" text [not null]
  "message" text [not null]
  "link" text [note: 'Optional in-app link ("/profile?tab=orders").']
  "is_read" boolean [not null, default: false]
  "read_at" timestamp(3)
  "user_id" text [not null, note: 'FK → users.id']
  "created_at" timestamp(3) [not null, default: `now()`]
  "updated_at" timestamp(3) [not null, note: 'Set by Prisma on every update (@updatedAt).']

  indexes {
    ("user_id", "is_read", "created_at")
  }

  Note: 'Prisma model: Notification.'
}

Table "activity_logs" [headercolor: #455A64] {
  "id" text [pk, note: 'Default: uuid v7 (generated by Prisma client).']
  "action" text [not null]
  "entity_type" text
  "entity_id" text
  "metadata" jsonb
  "ip_address" text
  "user_id" text [note: 'FK → users.id']
  "created_at" timestamp(3) [not null, default: `now()`]

  indexes {
    ("user_id", "created_at")
    ("entity_type", "entity_id")
    "created_at"
  }

  Note: 'Prisma model: ActivityLog.'
}

